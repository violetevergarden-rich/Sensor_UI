<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_deep"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/panel_mid"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_icon"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:id="@+id/tvUsbStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/status_usb_disconnected"
            android:textColor="@color/usb_disconnected"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bodyFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/bodyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/leftSidebar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@drawable/control_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/control_panel_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/control_panel_title"
                    style="@style/TextAppearance.SensorMonitor.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/control_panel_hint"
                    style="@style/TextAppearance.SensorMonitor.SectionHint" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_latitude"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchLatitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_longitude"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchLongitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_altitude"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAltitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_accel_x"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAccelX"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_accel_y"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAccelY"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_accel_z"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAccelZ"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_gyro_x"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchGyroX"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_gyro_y"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchGyroY"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_gyro_z"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchGyroZ"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_metric_speed"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/control_row_margin"
                            android:background="@drawable/control_row_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/control_row_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/table_visibility_label"
                                style="@style/TextAppearance.SensorMonitor.DataLabel" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchTable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <LinearLayout
                    android:id="@+id/bottomControlPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/switchMeasure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_start_pause" />

                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_settings"
                        android:src="@android:drawable/ic_menu_manage" />
                </LinearLayout>
            </LinearLayout>

        <LinearLayout
            android:id="@+id/rightDisplay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:background="@color/panel_deep"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3" />

            <LinearLayout
                android:id="@+id/dataPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="2"
                android:background="@color/panel_soft"
                android:orientation="vertical"
                android:padding="@dimen/data_panel_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_lat"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvLat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_lon"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvLon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_altitude"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvAltitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_speed"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_accel_mag"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvAccelMag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_gyro_mag"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvGyroMag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_yaw"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvYaw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_pitch"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvPitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_roll"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvRoll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_mag_x"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvMagX"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_mag_y"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvMagY"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_mag_z"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvMagZ"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_pressure"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_height"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_sv_count"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvSvCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_hdop"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvHdop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/data_card_margin"
                        android:background="@color/panel_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/data_card_padding">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_gps_fix"
                            style="@style/TextAppearance.SensorMonitor.DataLabel" />
                        <TextView
                            android:id="@+id/tvGpsFix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--"
                            style="@style/TextAppearance.SensorMonitor.DataValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/sidebarHandleTouch"
            android:layout_width="@dimen/sidebar_handle_touch_width"
            android:layout_height="@dimen/sidebar_handle_touch_height"
            android:layout_gravity="start|center_vertical"
            android:clickable="true"
            android:contentDescription="@string/action_toggle_sidebar"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:layout_width="@dimen/sidebar_handle_visual_width"
                android:layout_height="@dimen/sidebar_handle_visual_height"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/sidebar_handle_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivSidebarHandle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>